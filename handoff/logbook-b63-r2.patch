+/* Build 63. Narrow layouts reflow. They do not add a horizontal scroll port. */
+#compliance-panel-inspection .table-wrap {
+  overflow: visible;
+  max-width: 100%;
+}
+#compliance-panel-inspection table.compliance-table {
+  min-width: 0;
+  width: 100%;
+  table-layout: fixed;
+}
+#compliance-panel-inspection .compliance-table th,
+#compliance-panel-inspection .compliance-table td {
+  overflow-wrap: normal;
+  word-break: normal;
+  hyphens: manual;
+  white-space: normal;
+  overflow: visible;
+  text-overflow: clip;
+  vertical-align: top;
+}
+@media (max-width: 720px) {
+  #compliance-panel-inspection table.compliance-table,
+  #compliance-panel-inspection .compliance-table tbody,
+  #compliance-panel-inspection .compliance-table tr,
+  #compliance-panel-inspection .compliance-table td {
+    display: block;
+    width: 100%;
+  }
+  #compliance-panel-inspection .compliance-table thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+  #compliance-panel-inspection .compliance-table td {
+    display: grid;
+    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
+    gap: 0.35rem;
+  }
+  #compliance-panel-inspection .compliance-table td:nth-child(1)::before { content: "Plant code"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(2)::before { content: "Patient alias"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(3)::before { content: "Cert ID"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(4)::before { content: "Cultivar"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(5)::before { content: "Stage"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(6)::before { content: "Area"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(7)::before { content: "Tag status"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(8)::before { content: "Last updated"; }
+}
+.b57 {
+  margin-left: 0;
+  margin-right: 0;
+  width: auto;
+  max-width: 100%;
+  box-sizing: border-box;
+}
+.b57-scroll, .b57-row.scroll, .b59-kids, .b60-col {
+  overflow: visible;
+  max-width: 100%;
+  touch-action: pan-y;
+  scroll-snap-type: none;
+}
+.b57-row, .b59-kids, .b60-col { flex-wrap: wrap; max-width: 100%; }
+.b57-n, .b60-col > .b60-c { flex: 1 1 8rem; width: auto; max-width: 100%; min-width: 0; }
+.b57-n b, .b57-n small {
+  white-space: normal;
+  overflow-wrap: break-word;
+  word-break: normal;
+  hyphens: manual;
+  max-width: 100%;
+}
+.b60-full { max-width: 100%; }
+.b60-c { flex: 1 1 100%; min-width: 0; max-width: 100%; }
+.b57 .b18-h1, .b57-subt, .b57-tools { max-width: 100%; overflow-wrap: break-word; word-break: normal; }
+@media (max-width: 720px) {
+  .b60-cols { gap: 8px; }
+  .b60-c { min-height: 72px; }
+  .b57-n { flex: 1 1 calc(50% - 8px); }
+}
+.w-side, nav.w-side, .mfx-list, .w-list { min-width: 0; max-width: 100%; overflow: visible; }
+.w-side .w-l, .w-side .w-foot, .w-side .w-n, .w-side .w-li-t, .w-side .w-li-t b, .mfx-list .w-li-t b {
+  min-width: 0;
+  overflow-wrap: break-word;
+  word-break: normal;
+  white-space: normal;
+}
