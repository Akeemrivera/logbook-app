+async function ipadTree() {
+  const html = '/tmp/b63-r4-ipad.html';
+  const css = ['wide.css', 'build60.css', 'build63.css'].map((f) => '<link rel="stylesheet" href="file://' + path.join(ROOT, f) + '">').join('');
+  fs.writeFileSync(html, '<!doctype html><html data-layout="wide"><head><meta name="viewport" content="width=device-width, initial-scale=1">' + css + '</head><body style="margin:0">'
+    + '<nav class="w-side" data-wide="sidebar"><div class="w-foot">Saved on this device</div></nav>'
+    + '<div class="b60-full"><div class="b60-cols"><div class="b60-col l"><button class="b60-c">Left</button></div><div class="b60-col r"><button class="b60-c">Right</button></div></div></div>'
+    + '</body></html>');
+  const port = 9335;
+  const dir = '/tmp/b63-r4-chrome';
+  fs.rmSync(dir, { recursive: true, force: true });
+  const proc = require('child_process').spawn('/opt/google/chrome/chrome', [
+    '--headless=new', '--disable-gpu', '--no-sandbox', '--disable-dev-shm-usage',
+    '--user-data-dir=' + dir, '--remote-debugging-port=' + port, 'about:blank',
+  ], { stdio: 'ignore' });
+  const pending = new Map();
+  let n = 0;
+  try {
+    let page = null;
+    for (let i = 0; i < 50 && !page; i++) {
+      try {
+        const list = await (await fetch('http://127.0.0.1:' + port + '/json/list')).json();
+        page = list.find((t) => t.type === 'page' && t.webSocketDebuggerUrl);
+      } catch (e) { await sleep(100); }
+    }
+    if (!page) throw new Error('chrome did not open');
+    const ws = new WebSocket(page.webSocketDebuggerUrl);
+    await new Promise((resolve, reject) => { ws.addEventListener('open', resolve); ws.addEventListener('error', reject); });
+    ws.addEventListener('message', (ev) => {
+      const msg = JSON.parse(ev.data);
+      if (msg.id && pending.has(msg.id)) { const done = pending.get(msg.id); pending.delete(msg.id); done(msg); }
+    });
+    function send(method, params) {
+      const id = ++n;
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('timeout ' + method)), 8000);
+        pending.set(id, (msg) => { clearTimeout(timer); if (msg.error) reject(new Error(JSON.stringify(msg.error))); else resolve(msg.result); });
+        ws.send(JSON.stringify({ id, method, params: params || {} }));
+      });
+    }
+    await send('Emulation.setDeviceMetricsOverride', { width: 1024, height: 768, deviceScaleFactor: 1, mobile: false, scale: 1 });
+    await send('Page.enable');
+    await send('Page.navigate', { url: 'file://' + html });
+    for (let i = 0; i < 80; i++) {
+      const ready = await send('Runtime.evaluate', { expression: 'document.querySelectorAll(".b60-c").length', returnByValue: true });
+      if (ready.result && ready.result.value === 2) break;
+      await sleep(50);
+    }
+    await send('Emulation.setDeviceMetricsOverride', { width: 1024, height: 768, deviceScaleFactor: 1, mobile: false, scale: 1 });
+    const measured = await send('Runtime.evaluate', { expression: `(() => {
+      const view = window.innerWidth;
+      const side = document.querySelector('.w-side').getBoundingClientRect();
+      const tree = document.querySelector('.b60-full').getBoundingClientRect();
+      const doc = document.documentElement.scrollWidth;
+      return { view, doc, side: side.width, tree: tree.width, treeRight: tree.right, treeLeft: tree.left };
+    })()`, returnByValue: true });
+    return measured.result.value;
+  } finally { proc.kill('SIGKILL'); }
+}
