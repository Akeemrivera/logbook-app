+'use strict';
+/*
+  Released app must not create sample plants. Synthetic ids only.
+  A same-name user record stays. The developer seed global is ignored.
+*/
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+const ROOT = path.join(__dirname, '..');
+const FAIL = [];
+function check(name, fn) {
+  try { fn(); console.log('PASS', name); }
+  catch (e) { FAIL.push(name); console.error('FAIL', name, e && e.stack || e); process.exit(1); }
+}
+function element(id) {
+  return {
+    id: id || '', innerHTML: '', textContent: '', value: '', hidden: false, dataset: {}, style: {},
+    classList: { add() {}, remove() {}, toggle() {}, contains() { return false; } },
+    setAttribute() {}, getAttribute() { return ''; }, addEventListener() {},
+    querySelector() { return null; }, querySelectorAll() { return []; },
+  };
+}
+const byId = {};
+function remember(id) { if (!byId[id]) byId[id] = element(id); return byId[id]; }
+const document = {
+  readyState: 'complete', body: element('body'), documentElement: element('html'),
+  addEventListener() {}, createElement() { return element(''); },
+  getElementById(id) { return remember(id); },
+  querySelector(sel) { const m = /^#([\w-]+)$/.exec(sel || ''); return m ? remember(m[1]) : null; },
+  querySelectorAll() { return []; },
+};
+const store = new Map();
+const g = {
+  console, document,
+  localStorage: { getItem(k) { return store.has(k) ? store.get(k) : null; }, setItem(k, v) { store.set(k, String(v)); }, removeItem(k) { store.delete(k); } },
+  setInterval() { return 0; }, setTimeout() { return 0; }, clearInterval() {}, clearTimeout() {},
+  requestAnimationFrame() { return 0; },
+  matchMedia() { return { matches: false, addEventListener() {}, removeEventListener() {} }; },
+  MutationObserver: class { observe() {} disconnect() {} },
+  navigator: { storage: { persist() { return Promise.resolve(false); } } },
+  crypto: { randomUUID: () => 'syn-uuid' },
+  URL, Blob, Map, Date, JSON, Math, Number, String, Array, Object, RegExp, Promise, Set,
+  location: { hash: '', protocol: 'https:' },
+  addEventListener() {},
+  __BORIKEN_DEV_SEED: [
+    { name: 'Synthetic Sample Mother', role: 'mother' },
+    { name: 'Synthetic Sample Father', role: 'father' },
+  ],
+};
+g.window = g;
+g.globalThis = g;
+vm.createContext(g);
+vm.runInContext(fs.readFileSync(path.join(ROOT, 'app.js'), 'utf8'), g, { filename: 'app.js' });
+vm.runInContext(fs.readFileSync(path.join(ROOT, 'build13.js'), 'utf8'), g, { filename: 'build13.js' });
+vm.runInContext(fs.readFileSync(path.join(ROOT, 'build63.js'), 'utf8'), g, { filename: 'build63.js' });
+const state = vm.runInContext('state', g);
+
+check('a clean startup has no plants and ignores the developer seed list', () => {
+  if (state.plants.length || state.motherFatherPlants.length) throw new Error('startup not empty');
+  const starters = vm.runInContext('MF_STARTERS', g);
+  if (!Array.isArray(starters) || starters.length) throw new Error('starter list ' + JSON.stringify(starters));
+  g.mfSeedStarters();
+  if (state.plants.length || state.motherFatherPlants.length) throw new Error('seed inserted ' + state.motherFatherPlants.map((m) => m.name).join(','));
+  const html = g.mfSectionHtml();
+  if (html.includes('Add your plants') || html.includes('Synthetic Sample')) throw new Error(html);
+});
+
+state.motherFatherPlants.push(
+  { id: 'user-same-name', name: 'Rocco', role: 'father', status: 'Active', archived: false, cuttings: [], pollen: [] },
+  { id: 'user-live', name: 'Kept Mother', role: 'mother', status: 'Active', archived: false, cuttings: [], pollen: [] },
+);
+state.plants.push({ id: 'user-plant', name: 'Kept Grow', status: 'active', count: 1, logs: [], harvestDate: '' });
+const before = JSON.stringify(state);
+g.mfSeedStarters();
+const saved = JSON.stringify(state);
