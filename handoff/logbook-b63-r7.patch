+  const dads = reloaded.motherFatherPlants.filter((m) => g.B63.showMother(m) && m.role === 'father');
+  if (moms.length !== 1 || dads.length !== 1 || dads[0].id !== 'user-same-name') throw new Error('counts');
+  const active = g.activeStrains().map((p) => p.id);
+  if (!active.includes('user-plant') || active.length !== 1) throw new Error(active.join(','));
+});
+
+g.b18BrPageHtml = function () { return ''; };
+g.B18 = g.B18 || { brPage: null };
+g.renderBreeding = g.renderBreeding || function () {};
+['build49.js', 'build57.js'].forEach((rel) => {
+  vm.runInContext(fs.readFileSync(path.join(ROOT, rel), 'utf8'), g, { filename: rel });
+});
+check('tree and partner views do not add a sample or drop the same-name user record', () => {
+  const ids = reloaded.motherFatherPlants.map((m) => m.id).sort();
