+  const blob = JSON.stringify(partners || []);
+  if (/Synthetic Sample/.test(blob)) throw new Error(blob);
+  if (!reloaded.motherFatherPlants.some((m) => m.id === 'user-same-name' && m.name === 'Rocco')) throw new Error('same-name record missing');
+});
+
+check('shipped pages do not load the test fixture or the name-matched migration file', () => {
+  const index = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+  ['b57-fixture.js', 'build61.js', 'qa-b13.js'].forEach((name) => {
+    if (index.includes(name)) throw new Error(name + ' is loaded');
+  });
+});
+
+console.log('b63 no sample: clean startup and user records held');
