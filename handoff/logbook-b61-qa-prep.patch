 # - sim: the target must be a simulator udid (never a physical device).
 REAL=com.borikengenetics.logbookapp; APP=$1; T=$2; U=$3
 P=$APP/Info.plist; [ -f $APP/Wrapper/App.app/Info.plist ] && P=$APP/Wrapper/App.app/Info.plist
+[ -f "$APP/Wrapper/App.app/Info.plist" ] && APP=$APP/Wrapper/App.app
 ID=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$P" 2>/dev/null)
+[ "$ID" = "$REAL" ] && { echo "RIG-GUARD: refusing test run with the real bundle id $REAL (would use live data or production iCloud)"; exit 4; }
+check_ents() {
+  local ent
+  ent=$(codesign -d --entitlements :- "$1" 2>/dev/null) || { echo "RIG-GUARD: could not read the code signature"; exit 4; }
+  echo "$ent" | grep -q 'iCloud.com.borikengenetics.logbookapp' && { echo "RIG-GUARD: refusing production iCloud container"; exit 4; }
+  echo "$ent" | grep -q 'keychain-access-groups' && { echo "RIG-GUARD: refusing keychain sharing"; exit 4; }
+  echo "$ent" | grep -q 'application-groups' && { echo "RIG-GUARD: refusing an app group"; exit 4; }
+  echo "$ent" | grep -q 'ubiquity-container-identifiers' && { echo "RIG-GUARD: refusing an iCloud Drive container"; exit 4; }
+}
 if [ "$T" = mac ]; then
-  [ "$ID" = "$REAL" ] && { echo "RIG-GUARD: refusing Mac test run with the real bundle id $REAL (would write into Elio's real data)"; exit 4; }
   pgrep -f "Borikèn Logbook.app/" >/dev/null && { echo "RIG-GUARD: installed Logbook is open"; exit 4; }
+  check_ents "$APP"
 elif [ "$T" = sim ]; then
   xcrun simctl list devices | grep -q "($U)" || { echo "RIG-GUARD: $U is not a simulator"; exit 4; }
+  check_ents "$APP"
 else echo "RIG-GUARD: target must be sim or mac"; exit 4; fi
 echo "RIG-GUARD ok: $ID on $T"
