@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Check the QA build mode in source. Does not compile or launch."""
+import plistlib
+import sys
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+pbx = (root / "ios/App/App.xcodeproj/project.pbxproj").read_text()
+prod_ent = (root / "ios/App/App/App.entitlements").read_text()
+qa_ent = (root / "ios/App/App/App.qa.entitlements").read_text()
+prod_info = (root / "ios/App/App/Info.plist").read_text()
+qa_info = (root / "ios/App/App/Info.qa.plist").read_text()
+errors = []
+
+def need(cond, msg):
+    if not cond:
+        errors.append(msg)
+
+need(pbx.count("PRODUCT_BUNDLE_IDENTIFIER = com.borikengenetics.logbookapp;") == 2, "Debug and Release must keep the production bundle id")
+need("PRODUCT_BUNDLE_IDENTIFIER = com.borikengenetics.logbookapp.qa;" in pbx, "QA bundle id missing")
+need(pbx.count("CODE_SIGN_ENTITLEMENTS = App/App.entitlements;") == 2, "Debug and Release must keep production entitlements")
+need("CODE_SIGN_ENTITLEMENTS = App/App.qa.entitlements;" in pbx, "QA entitlements path missing")
+need("INFOPLIST_FILE = App/Info.qa.plist;" in pbx, "QA Info.plist path missing")
+need('SWIFT_ACTIVE_COMPILATION_CONDITIONS = "DEBUG QA_ISOLATION";' in pbx, "QA compile flag missing")
+need("name = QA;" in pbx, "QA configuration missing")
+need("504EC3191FED79650016851F /* QA */" in pbx and "504EC31A1FED79650016851F /* QA */" in pbx, "QA config not listed")
+need("iCloud.com.borikengenetics.logbookapp" in prod_ent, "production entitlements lost the iCloud container")
+need("iCloud.com.borikengenetics.logbookapp" not in qa_ent, "QA entitlements name the production container")
+for banned in ("keychain-access-groups", "application-groups", "icloud-container", "icloud-services", "ubiquity-container"):
+    need(banned not in qa_ent, f"QA entitlements contain {banned}")
+need("keychain-access-groups" not in prod_ent and "application-groups" not in prod_ent, "production entitlements unexpectedly gained sharing")
+need("NSUbiquitousContainers" in prod_info and "iCloud.com.borikengenetics.logbookapp" in prod_info, "production Info.plist lost its container")
+need("iCloud.com.borikengenetics.logbookapp" not in qa_info, "QA Info.plist names the production container")
+need("Borikèn Logbook QA" in qa_info, "QA display name missing")
+need("remote-notification" not in qa_info, "QA Info.plist still requests remote notification")
+for name in ("CloudSyncPlugin.swift", "ICloudBackupPlugin.swift"):
+    text = (root / "ios/App/App" / name).read_text()
+    need("QA_ISOLATION" in text and "qaBlocked" in text, f"{name} has no QA guard")
+    need(text.count("This QA build cannot use iCloud.") == 1, f"{name} guard text")
+scheme = root / "ios/App/App.xcodeproj/xcshareddata/xcschemes/App-QA.xcscheme"
+need(scheme.is_file(), "App-QA scheme missing")
+scheme_text = scheme.read_text() if scheme.is_file() else ""
+need('buildConfiguration = "QA"' in scheme_text, "App-QA scheme does not build QA")
+need("Release" not in scheme_text, "App-QA scheme mentions Release")
+cap = (root / "ios/App/App/capacitor.config.json").read_text()
+need('"appId": "com.borikengenetics.logbookapp"' in cap, "capacitor appId was changed")
+bw = (root / "scripts/build-www.js").read_text()
+need("'build61.js'" in bw and "'build61.css'" in bw, "build-www.js does not pack build 61")
+rm_at = bw.find("fs.rmSync(www")
+pre_at = bw.find("PREP REFUSED")
+need(0 <= pre_at < rm_at, "www/ can still be deleted before the source check")
+app = (root / "app.js").read_text()
+need("const APP_BUILD = '61';" in app, "root app.js is not build 61")
+need("const APP_BUILD = '60';" not in app, "root app.js still says build 60")
+
+if errors:
+    print("\n".join(f"FAIL {e}" for e in errors))
+    sys.exit(1)
+print("PASS qa config keeps production Debug/Release and isolates QA")
