+#!/bin/zsh
+# QA compile only. Never Debug, Release, install, or launch.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+ROOT=$PWD
+if [[ "${1:-QA}" != "QA" ]]; then
+  echo "Refusing configuration ${1}. This script builds QA only."
+  exit 2
+fi
+zsh scripts/prep-www.sh
+python3 scripts/verify-qa-config.py
+xcodebuild \
+  -project ios/App/App.xcodeproj \
+  -scheme App-QA \
+  -configuration QA \
+  -destination 'platform=macOS,variant=Designed for iPad' \
+  -derivedDataPath "$ROOT/build/qa-derived" \
+  build
+APP=$(find "$ROOT/build/qa-derived" -type d -name 'App.app' -print | head -n 1)
+if [[ -z "$APP" ]]; then
+  echo "QA build finished but App.app was not found."
+  exit 1
+fi
+zsh scripts/verify-qa-app.sh "$APP"
+echo "QA build verified: $APP"
+echo "Not installed and not launched. Next, with the production Logbook quit:"
+echo "  zsh rig-guard.sh \"$APP\" mac"
+echo "Open it only after rig-guard prints ok. Do not open the production app."
