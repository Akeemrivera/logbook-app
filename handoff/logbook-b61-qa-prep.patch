+#!/usr/bin/env node
+'use strict';
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const root = path.join(__dirname, '..');
+const SHIPPED = '3c949b1a8b34d6f20590ac690de430e5aa53384b7c891008a80fd1ae3e97d399';
+let failed = 0;
+function fail(msg) { failed += 1; console.error('FAIL', msg); }
+function pass(msg) { console.log('PASS', msg); }
+function sha(file) { return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex'); }
+const app = path.join(root, 'app.js');
+if (!fs.existsSync(app)) fail('root app.js missing');
+else if (sha(app) !== SHIPPED) fail(`root app.js ${sha(app)} is not the shipped b61 bytes ${SHIPPED}`);
+else pass('root app.js matches the shipped b61 app.js bytes');
+for (const rel of ['www/app.js', 'ios/App/App/public/app.js']) {
+  const file = path.join(root, rel);
+  if (!fs.existsSync(file)) { fail(`${rel} missing`); continue; }
+  if (sha(file) !== sha(app)) fail(`${rel} differs from root app.js`);
+  else pass(`${rel} matches root app.js`);
+}
+const bw = fs.readFileSync(path.join(root, 'scripts/build-www.js'), 'utf8');
+if (!bw.includes("'build61.js'") || !bw.includes("'build61.css'")) fail('build-www.js omits build 61');
+else pass('build-www.js packs build61.js and build61.css');
+if (!(bw.indexOf('PREP REFUSED') >= 0 && bw.indexOf('PREP REFUSED') < bw.indexOf('fs.rmSync(www'))) fail('www wipe is not guarded');
+else pass('www wipe is refused when a listed source file is missing');
+{
+  const prep = fs.readFileSync(path.join(root, 'scripts/prep-www.sh'), 'utf8');
+  const commands = prep.split('\n').filter((line) => !line.trim().startsWith('#')).join('\n');
+  if (/\bnpx\b|\bcap\b/.test(commands)) fail('prep invokes Capacitor sync');
+  else pass('prep does not invoke Capacitor sync');
+}
+const qa = fs.readFileSync(path.join(root, 'scripts/qa-build.sh'), 'utf8');
+if (qa.includes('-configuration Debug') || qa.includes('-configuration Release') || qa.includes('npx cap')) fail('qa-build can select a production command');
+else if (!qa.includes('-configuration QA') || !qa.includes('App-QA')) fail('qa-build does not target the QA scheme');
+else pass('qa-build is QA-only and does not sync Capacitor');
+if (failed) process.exit(1);
+console.log(`prep-delta ${failed ? 'failed' : 'ok'}`);
