+#!/bin/zsh
+# Copy root web sources into www/ and then into the Xcode public folder.
+# Does not launch the app. Stops if the version check fails.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+ROOT=$PWD
+node scripts/build-www.js
+node --input-type=module -e '
+import fs from "fs";
+import crypto from "crypto";
+const root = fs.readFileSync("app.js");
+const www = fs.readFileSync("www/app.js");
+if (!root.equals(www)) {
+  console.error("PREP REFUSED: www/app.js does not match root app.js after the copy.");
+  process.exit(1);
+}
+fs.cpSync("www", "ios/App/App/public", { recursive: true, force: true });
+const pub = fs.readFileSync("ios/App/App/public/app.js");
+if (!root.equals(pub)) {
+  console.error("PREP REFUSED: embedded public/app.js does not match root app.js.");
+  process.exit(1);
+}
+const hash = crypto.createHash("sha256").update(root).digest("hex");
+console.log("prep-www app.js", hash);
+'
+echo "prep-www done. Did not compile or launch."
