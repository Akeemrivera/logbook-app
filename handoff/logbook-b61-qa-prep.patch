+#!/bin/zsh
+# Check a built QA app without launching it.
+set -euo pipefail
+APP=${1:?path to App.app}
+P=$APP/Info.plist
+[[ -f $APP/Wrapper/App.app/Info.plist ]] && P=$APP/Wrapper/App.app/Info.plist && APP=$APP/Wrapper/App.app
+ID=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$P")
+NAME=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$P")
+[[ "$ID" == "com.borikengenetics.logbookapp.qa" ]] || { echo "VERIFY FAIL: bundle id is $ID"; exit 1; }
+[[ "$NAME" == "Borikèn Logbook QA" ]] || { echo "VERIFY FAIL: display name is $NAME"; exit 1; }
+if /usr/libexec/PlistBuddy -c 'Print :NSUbiquitousContainers' "$P" >/dev/null 2>&1; then
+  echo "VERIFY FAIL: QA Info.plist still declares an iCloud container"
+  exit 1
+fi
+ENT=$(codesign -d --entitlements :- "$APP" 2>/dev/null) || { echo "VERIFY FAIL: no code signature"; exit 1; }
+echo "$ENT" | grep -q 'iCloud.com.borikengenetics.logbookapp' && { echo "VERIFY FAIL: production iCloud container"; exit 1; }
+echo "$ENT" | grep -q 'keychain-access-groups' && { echo "VERIFY FAIL: keychain sharing"; exit 1; }
+echo "$ENT" | grep -q 'application-groups' && { echo "VERIFY FAIL: app group"; exit 1; }
+echo "$ENT" | grep -q 'ubiquity-container-identifiers' && { echo "VERIFY FAIL: iCloud Drive entitlement"; exit 1; }
+echo "$ENT" | grep -q 'icloud-services' && { echo "VERIFY FAIL: iCloud service entitlement"; exit 1; }
+if strings "$APP/App" 2>/dev/null | grep -q 'iCloud.com.borikengenetics.logbookapp'; then
+  echo "VERIFY FAIL: QA binary still contains the production iCloud container id"
+  exit 1
+fi
+echo "VERIFY ok: $ID ($NAME) has no production iCloud, keychain sharing, or app group"
