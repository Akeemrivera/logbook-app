@@ -0,0 +1,132 @@
+'use strict';
+/*
+  The renderer failure: the second controlled viewport got net::ERR_FAILED
+  for deferred scripts that were already in the cache, and the server never
+  saw those requests. This loads the real worker, waits until all precache
+  entries exist, then navigates the same profile through the renderer's
+  viewports online and once offline. Every same-origin deferred script must
+  finish at HTTP 200. A failed script is reported once, not retried.
+*/
+const fs = require('fs');
+const http = require('http');
+const path = require('path');
+const { spawn } = require('child_process');
+const ROOT = path.join(__dirname, '..');
+const CHROME = '/opt/google/chrome/chrome';
+const VIEWPORTS = [[390, 844], [1024, 768], [1024, 1366]];
+const html = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+const scripts = [...html.matchAll(/<script src="([^"]+)" defer>/g)].map((m) => '/' + m[1]);
+if (scripts.length < 30 || !scripts.includes('/build18.js') || !scripts.includes('/build63.js')) {
+  console.error('FAIL deferred script list ' + scripts.join(' '));
+  process.exit(1);
+}
+function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
+function pathOf(url) {
+  try { return decodeURIComponent(new URL(url).pathname); }
+  catch (e) { return ''; }
+}
+
+async function main() {
+  if (!fs.existsSync(CHROME)) { console.error('FAIL chrome missing'); process.exit(1); }
+  const probe = http.createServer();
+  const port = await new Promise((resolve) => probe.listen(0, '127.0.0.1', () => { const p = probe.address().port; probe.close(() => resolve(p)); }));
+  const debugProbe = http.createServer();
+  const debug = await new Promise((resolve) => debugProbe.listen(0, '127.0.0.1', () => { const p = debugProbe.address().port; debugProbe.close(() => resolve(p)); }));
+  const server = http.createServer((req, res) => {
+    let rel = decodeURIComponent(new URL(req.url, 'http://127.0.0.1').pathname);
+    if (rel === '/') rel = '/index.html';
+    const file = path.normalize(path.join(ROOT, rel.replace(/^\/+/, '')));
+    if ((!file.startsWith(ROOT + path.sep) && file !== ROOT) || !fs.existsSync(file) || !fs.statSync(file).isFile()) {
+      res.statusCode = 404; res.end('missing'); return;
+    }
+    const type = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.webmanifest': 'application/manifest+json', '.svg': 'image/svg+xml', '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.ttf': 'font/ttf', '.woff2': 'font/woff2', '.pdf': 'application/pdf' }[path.extname(file).toLowerCase()] || 'application/octet-stream';
+    res.setHeader('Content-Type', type);
+    res.end(fs.readFileSync(file));
+  });
+  await new Promise((resolve) => server.listen(port, '127.0.0.1', resolve));
+  const dir = fs.mkdtempSync(path.join(require('os').tmpdir(), 'b63-sw-viewport-'));
+  const proc = spawn(CHROME, ['--headless=new', '--disable-gpu', '--no-sandbox', '--disable-dev-shm-usage', '--user-data-dir=' + dir, '--remote-debugging-port=' + debug, 'about:blank'], { stdio: 'ignore' });
+  const requests = new Map();
+  try {
+    let page = null;
+    for (let i = 0; i < 50 && !page; i++) {
+      try { const list = await (await fetch('http://127.0.0.1:' + debug + '/json/list')).json(); page = list.find((t) => t.type === 'page' && t.webSocketDebuggerUrl); }
+      catch (e) { await sleep(100); }
+    }
+    if (!page) throw new Error('chrome did not open');
+    const ws = new WebSocket(page.webSocketDebuggerUrl);
+    await new Promise((resolve, reject) => { ws.addEventListener('open', resolve); ws.addEventListener('error', reject); });
+    let n = 0; const pending = new Map();
+    ws.addEventListener('message', (ev) => {
+      const msg = JSON.parse(ev.data);
+      const params = msg.params || {};
+      if (msg.method === 'Network.requestWillBeSent' && params.requestId) {
+        requests.set(params.requestId, { url: params.request && params.request.url || '', type: params.type || '', will: Date.now(), status: 0, mime: '', failed: '', fromServiceWorker: false, origin: '' });
+      }
+      const row = params.requestId ? requests.get(params.requestId) : null;
+      if (row && msg.method === 'Network.responseReceived') {
+        const response = params.response || {};
+        row.status = response.status || 0;
+        row.mime = response.mimeType || '';
+        row.fromServiceWorker = !!response.fromServiceWorker;
+        try { row.origin = new URL(row.url).origin; } catch (e) { row.origin = ''; }
+      }
+      if (row && msg.method === 'Network.loadingFinished') row.done = true;
+      if (row && msg.method === 'Network.loadingFailed') { row.failed = params.errorText || 'failed'; row.done = true; }
+      if (msg.id && pending.has(msg.id)) { const done = pending.get(msg.id); pending.delete(msg.id); done(msg); }
+    });
+    function send(method, params) {
+      const id = ++n;
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('timeout ' + method)), 15000);
+        pending.set(id, (msg) => { clearTimeout(timer); if (msg.error) reject(new Error(JSON.stringify(msg.error))); else resolve(msg.result || {}); });
+        ws.send(JSON.stringify({ id, method, params: params || {} }));
+      });
+    }
+    async function evaluate(expression) {
+      const out = await send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true });
+      if (out.exceptionDetails) throw new Error(JSON.stringify(out.exceptionDetails).slice(0, 300));
+      return out.result && out.result.value;
+    }
+    await send('Network.enable');
+    await send('Page.enable');
+    await send('Runtime.enable');
+    const origin = 'http://127.0.0.1:' + port;
+    async function open(label, w, h, offline) {
+      const started = Date.now();
+      requests.clear();
+      await send('Network.emulateNetworkConditions', { offline: !!offline, latency: 0, downloadThroughput: -1, uploadThroughput: -1 });
+      await send('Emulation.setDeviceMetricsOverride', { width: w, height: h, deviceScaleFactor: 1, mobile: w < 900 });
+      await send('Page.navigate', { url: origin + '/index.html?screen=tree' });
+      let ready = false;
+      for (let i = 0; i < 40 && !ready; i++) {
+        const snap = await evaluate('!!(window.__b63RepairReady && window.__b63Boot && window.__b63Boot.ready)');
+        ready = snap === true;
+        if (!ready) await sleep(50);
+      }
+      const scriptsNow = [...requests.values()].filter((row) => scripts.includes(pathOf(row.url)));
+      const bad = scriptsNow.filter((row) => row.failed || row.status !== 200);
+      return { label, offline: !!offline, ready, ms: Date.now() - started, bad: bad.map((row) => pathOf(row.url) + ' status=' + row.status + ' ' + row.failed + ' url=' + row.url), seen: scriptsNow.map((row) => pathOf(row.url)) };
+    }
+    const first = await open('390', 390, 844, false);
+    let filled = null;
+    for (let i = 0; i < 40 && !(filled && filled.count >= 125 && filled.controlled); i++) {
+      filled = await evaluate('(async () => { const names = await caches.keys(); let count = 0; for (const name of names) count += (await (await caches.open(name)).keys()).length; return { count, controlled: !!(navigator.serviceWorker && navigator.serviceWorker.controller), names }; })()');
+      if (!filled || filled.count < 125 || !filled.controlled) await sleep(100);
+    }
+    if (!filled || filled.count < 125 || !filled.controlled) throw new Error('precache did not finish ' + JSON.stringify(filled));
+    console.log('PASS precache ' + filled.count + ' ' + filled.names.join(','));
+    const passes = [await open('1024x768', 1024, 768, false), await open('1024x1366', 1024, 1366, false), await open('offline', 1024, 768, true)];
+    const failed = [first, ...passes].filter((row) => !row.ready || row.bad.length || scripts.some((src) => row.label !== '390' && !row.seen.includes(src)));
+    passes.forEach((row) => console.log('PASS viewport ' + row.label + ' scripts=' + row.seen.length + ' ready=' + row.ready + ' ms=' + row.ms));
+    if (!first.ready) throw new Error('first viewport did not boot ' + JSON.stringify(first));
+    if (failed.length) throw new Error('controlled script fetch failed ' + JSON.stringify(failed));
+    console.log('b63 sw viewport: cached shell served every deferred script online and offline');
+  } finally {
+    try { proc.kill('SIGKILL'); } catch (e) {}
+    server.close();
+    await sleep(200);
+    try { fs.rmSync(dir, { recursive: true, force: true, maxRetries: 2 }); } catch (e) {}
