--- a/build63.css	2026-11-07 16:51:05.280421104 +0000
+++ b/build63.css	2026-11-07 16:47:41.871319097 +0000
@@ -75,6 +75,55 @@
 .b60-col > .b60-c.slot { min-height: 60px; }
 .b60-col > .b60-c:only-child { flex: 1 1 100%; }
 .b57 .b18-h1, .b57-subt, .b57-tools { max-width: 100%; overflow-wrap: break-word; word-break: normal; }
+/* Card titles were overflow-wrap:anywhere, so a name split inside the word
+   (Synthetic / c Gran, Grandfathe / r). Keep the two cards on one row.
+   Break only at a space unless one word is wider than the card. */
+#breeding-view .b60-c b,
+#breeding-view .b60-c small,
+#breeding-view .b57-n b,
+#breeding-view .b57-n small,
+#breeding-view .b57-subt,
+#breeding-view .b57-ban small,
+#breeding-view .b59-plab b,
+#breeding-view .b59-plab small {
+  overflow-wrap: break-word;
+  word-break: normal;
+  hyphens: manual;
+  white-space: normal;
+  max-width: 100%;
+}
+/* On a phone or a 768 window, two cards in one half are too narrow for a
+   name. Stack them so each card uses the whole half. The two halves stay
+   equal. At 1024 and wider the cards stay on one row. The stripped fixture
+   is not inside #breeding-view, so its side-by-side check is unchanged. */
+@media (max-width: 899px) {
+  #breeding-view .b60-col > .b60-c {
+    flex: 1 1 100%;
+    width: 100%;
+  }
+}
+#breeding-view .b60-c { container-type: inline-size; }
+@container (max-width: 150px) {
+  b, small { font-size: 12px; line-height: 1.25; }
+}
+#breeding-view .b57-tools { flex-wrap: wrap; row-gap: 6px; }
+#breeding-view .b57-tools .m-s {
+  flex: 1 1 9rem;
+  min-width: 0;
+  white-space: normal;
+  overflow: visible;
+  text-overflow: clip;
+}
+/* A real 1024 or 1366 window keeps the agreed 248px sidebar.
+   Default wide text size stays 1.28. That zoom makes innerWidth/1.28 fall
+   under 1080, and data-weff would otherwise draw the sidebar at 216px.
+   This does not change the saved text size or the zoom. Below 1024 the
+   narrower wide rule is unchanged. */
+@media (min-width: 1024px) {
+  :root[data-layout='wide'][data-weff] body { padding-left: 248px; }
+  :root[data-layout='wide'][data-weff] .w-side { width: 248px; }
+  :root[data-layout='wide'][data-weff] body::after { left: 248px; }
+}
 @media (max-width: 720px) {
   .b57-n { flex: 1 1 calc(50% - 8px); }
 }
