--- a/build59.css
+++ b/build59.css
@@ -27,6 +27,27 @@
 html.b59-locked, html.b59-locked body { overscroll-behavior: none; }
 dialog.modal, .b58-card, .b49-full[open] { overscroll-behavior: contain; -webkit-overflow-scrolling: touch; overflow-y: auto; }
 dialog.modal { max-height: calc(var(--b59-vvh, 100dvh) - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 16px); }
+/* The dialog box itself must not grow past the window. A too-tall centered dialog clips
+   its header above the window and its Save row below it, and scrolling inside that box
+   never brings either end on screen. Cap the box at the viewport, and scroll the card. */
+dialog.modal {
+  box-sizing: border-box;
+  height: fit-content;
+  max-height: min(
+    calc(var(--b59-vvh, 100%) - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 16px),
+    calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 16px)
+  );
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+dialog.modal > .modal-card {
+  box-sizing: border-box;
+  min-height: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  -webkit-overflow-scrolling: touch;
+}
 dialog.sheet { max-height: calc(var(--b59-vvh, 100dvh) - env(safe-area-inset-top) - 12px); }
 .b58-card { max-height: calc(var(--b59-vvh, 100dvh) - env(safe-area-inset-top) - 12px); touch-action: pan-y; }
 dialog.modal::backdrop { overscroll-behavior: contain; touch-action: none; }
