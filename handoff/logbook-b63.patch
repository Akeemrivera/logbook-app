+++ b/build63.css	2026-11-07 14:45:30.930963267 +0000
@@ -0,0 +1,67 @@
+/* Build 63. Narrow layouts reflow. They do not add a horizontal scroll port. */
+#compliance-panel-inspection .table-wrap {
+  overflow: visible;
+  max-width: 100%;
+}
+#compliance-panel-inspection table.compliance-table {
+  min-width: 0;
+  width: 100%;
+  table-layout: fixed;
+}
+#compliance-panel-inspection .compliance-table th,
+#compliance-panel-inspection .compliance-table td {
+  overflow-wrap: normal;
+  word-break: normal;
+  hyphens: manual;
+  white-space: normal;
+  overflow: visible;
+  text-overflow: clip;
+  vertical-align: top;
+}
+@media (max-width: 720px) {
+  #compliance-panel-inspection table.compliance-table,
+  #compliance-panel-inspection .compliance-table tbody,
+  #compliance-panel-inspection .compliance-table tr,
+  #compliance-panel-inspection .compliance-table td {
+    display: block;
+    width: 100%;
+  }
+  #compliance-panel-inspection .compliance-table thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+  #compliance-panel-inspection .compliance-table td {
+    display: grid;
+    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
+    gap: 0.35rem;
+  }
+  #compliance-panel-inspection .compliance-table td:nth-child(1)::before { content: "Plant code"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(2)::before { content: "Patient alias"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(3)::before { content: "Cert ID"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(4)::before { content: "Cultivar"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(5)::before { content: "Stage"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(6)::before { content: "Area"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(7)::before { content: "Tag status"; }
+  #compliance-panel-inspection .compliance-table td:nth-child(8)::before { content: "Last updated"; }
+}
+.b57-scroll, .b57-row.scroll, .b59-kids {
+  overflow-x: clip;
+  max-width: 100%;
+  touch-action: pan-y;
+}
+.b57-row, .b59-kids { flex-wrap: wrap; max-width: 100%; }
+.b57-n { flex: 1 1 8rem; width: auto; max-width: 100%; min-width: 0; }
+.b57-n b, .b57-n small {
+  white-space: normal;
+  overflow-wrap: break-word;
+  word-break: normal;
+  hyphens: manual;
+  max-width: 100%;
+}
+@media (min-width: 1024px) {
+  .w-side { min-width: 0; overflow-x: clip; }
+  .w-side .w-li-t, .w-side .w-li-t b { min-width: 0; overflow-wrap: break-word; word-break: normal; }
+}
diff -ruN --exclude assets --exclude mascots --exclude manual --exclude '*.jpg' --exclude '*.png' --exclude '*.pdf' --exclude '*.ttf' b62-base/build63.js b62-app/build63.js
--- a/build63.js	1970-01-01 00:00:00.000000000 +0000
+++ b/build63.js	2026-11-07 14:45:55.770912801 +0000
@@ -0,0 +1,129 @@
+/* Build 63. View projections only. Nothing here writes state, merges records, or deletes history.
+   Hidden ids start empty. A record is hidden only when its id is passed to configure.
+   Names, sample flags, and descendant links are not used. */
+(function () {
+  'use strict';
+  const hiddenIds = new Set();
+  function configure(opts) {
+    hiddenIds.clear();
+    const ids = opts && Array.isArray(opts.hideIds) ? opts.hideIds : [];
+    ids.forEach((id) => { if (typeof id === 'string' && id) hiddenIds.add(id); });
+    return { hideIds: [...hiddenIds] };
+  }
+  function retiredMf(r) {
+    return !!(r && (r.status === 'Retired' || r.archived));
+  }
+  function explicitId(r) {
+    return !!(r && r.id && hiddenIds.has(r.id));
+  }
+  function explicitKey(k) {
+    if (!k || k === '?') return false;
+    const text = String(k);
+    if (hiddenIds.has(text)) return true;
+    const id = text.split(':').slice(1).join(':');
+    return !!(id && hiddenIds.has(id));
+  }
+  function projectActiveMothers(list) {
+    return (list || []).filter((r) => r && !retiredMf(r) && !explicitId(r));
+  }
+  function projectVisible(list) {
+    return (list || []).filter((r) => r && !explicitId(r));
+  }
+  function sameRecord(a, b) {
+    if (!a || !b) return false;
+    if (a === b) return true;
+    const as = String(a); const bs = String(b);
+    const ai = as.split(':').slice(1).join(':');
+    const bi = bs.split(':').slice(1).join(':');
+    return as.split(':')[0] === bs.split(':')[0] && ai && ai === bi;
+  }
+  function keepChild(parentKey, childKey) {
+    if (!childKey || childKey === parentKey || sameRecord(parentKey, childKey)) return false;
+    if (explicitKey(childKey)) return false;
+    return true;
+  }
+  function allowArchive(shownId, requestedId) {
+    if (!requestedId) return false;
+    if (shownId && shownId !== requestedId) return false;
+    return true;
+  }
+  function pendingMetadata() {
+    return [
+      'Sample record stable id, and any verified sample-only link ids. hideIds is empty, so nothing is hidden.',
+      'Duplicate parent record ids and the grow-plant ids for the missing crosses. No merge and no partner rewrite.',
+      'The one parent record id for the origin text. No name-matched write.',
+      'The retired mother id from the reported count. Every Retired mother or father leaves active lists. That count is not verified here.',
+      'The grow-plant id and the archive event. No date or status rewrite.',
+    ];
+  }
+  function projectMotherDom(doc) {
+    if (!doc || typeof doc.querySelectorAll !== 'function') return;
+    doc.querySelectorAll('#mfp-mc [data-id], #mfp-fc [data-id], #mfp-entry [data-id], .mfx-list [data-id]').forEach((el) => {
+      if (el.closest && el.closest('.b57, .b59-fam')) return;
+      const id = el.getAttribute('data-id');
+      const status = el.querySelector ? (el.querySelector('.m-s') || {}).textContent || '' : '';
+      if (hiddenIds.has(id) || /^Retired\b/.test(String(status).trim())) el.remove();
+    });
+    const setCount = (sel, tab, label) => {
+      const n = doc.querySelectorAll(sel).length;
+      doc.querySelectorAll('[data-mfp="tab"][data-t="' + tab + '"]').forEach((b) => { b.textContent = label + n; });
+    };
+    setCount('#mfp-mc .mfp-row', 'm', 'Mothers · ');
+    setCount('#mfp-fc .mfp-row', 'f', 'Fathers · ');
+  }
+  function install() {
+    if (window.B49 && typeof B49.children === 'function' && !B49.children.b63) {
+      const orig = B49.children;
+      const wrapped = function (key) { return orig.apply(this, arguments).filter((k) => keepChild(key, k)); };
+      wrapped.b63 = true;
+      B49.children = wrapped;
+    }
+    if (window.B57 && typeof B57.partners === 'function' && !B57.partners.b63) {
+      const orig = B57.partners;
+      const wrapped = function () {
+        return orig.apply(this, arguments).filter((g) => !g || !g.key || g.key === '?' || !explicitKey(g.key));
+      };
+      wrapped.b63 = true;
+      B57.partners = wrapped;
+    }
+    if (window.B57 && typeof B57.lineageList === 'function' && !B57.lineageList.b63) {
+      const orig = B57.lineageList;
+      const wrapped = function () { return orig.apply(this, arguments).filter((x) => x && !explicitId(x.r)); };
+      wrapped.b63 = true;
+      B57.lineageList = wrapped;
+    }
+    if (window.B41 && typeof B41.mfpOpen === 'function' && !B41.mfpOpen.b63) {
+      const orig = B41.mfpOpen;
+      const wrapped = function () {
+        const result = orig.apply(this, arguments);
+        projectMotherDom(typeof document !== 'undefined' ? document : null);
+        return result;
+      };
+      wrapped.b63 = true;
+      B41.mfpOpen = wrapped;
+    }
+    ['activeStrains', 'sortedActiveStrains'].forEach((name) => {
+      const orig = window[name];
+      if (typeof orig !== 'function' || orig.b63) return;
+      const wrapped = function () { return projectVisible(orig.apply(this, arguments)); };
+      wrapped.b63 = true;
+      window[name] = wrapped;
+    });
+    if (typeof window.archivePlant === 'function' && !window.archivePlant.b63) {
+      const orig = window.archivePlant;
+      const wrapped = function (id) {
+        const shown = typeof detailPlantId === 'function' ? detailPlantId() : '';
+        if (!allowArchive(shown, id)) return;
+        return orig.apply(this, arguments);
+      };
+      wrapped.b63 = true;
+      window.archivePlant = wrapped;
+    }
+  }
+  window.B63 = {
+    configure, retiredMf, explicitId, explicitKey, projectActiveMothers, projectVisible,
+    sameRecord, keepChild, allowArchive, pendingMetadata, projectMotherDom, install,
+    hiddenIds: () => [...hiddenIds],
+  };
+  install();
+})();
