+'use strict';
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+const ROOT = path.join(__dirname, '..');
+const FAIL = [];
+function check(name, fn) {
+  try { fn(); console.log('PASS', name); }
+  catch (e) { FAIL.push(name); console.error('FAIL', name, e.message); console.error('FAILED', FAIL.length); process.exit(1); }
+}
+const src = fs.readFileSync(path.join(ROOT, 'build63.js'), 'utf8');
+const css = fs.readFileSync(path.join(ROOT, 'build63.css'), 'utf8');
+const app = fs.readFileSync(path.join(ROOT, 'app.js'), 'utf8');
+const b59 = fs.readFileSync(path.join(ROOT, 'build59.css'), 'utf8');
+const tags = fs.readFileSync(path.join(ROOT, 'styles.css'), 'utf8');
+
+function boot(state) {
+  const recs = {};
+  (state.motherFatherPlants || []).forEach((r) => { recs['mf:' + r.id] = r; });
+  (state.plants || []).forEach((r) => { recs['pl:' + r.id] = r; });
+  (state.breedingProjects || []).forEach((r) => { recs['pr:' + r.id] = r; });
+  const g = {
+    state,
+    console,
+    document: { readyState: 'complete', addEventListener() {} },
+    B57: { rec: (k) => recs[k] || null },
+    B49: { children(key) { return state._kids[key] || []; } },
+    B41: { mfpOpen() { g.seen = (state.motherFatherPlants || []).map((m) => m.id); } },
+    B42: { listHtml() { g.listed = (state.motherFatherPlants || []).map((m) => m.id); return ''; } },
+    activeStrains() { return (state.plants || []).filter((p) => p.status === 'active'); },
+    sortedActiveStrains() { return g.activeStrains(); },
+    archivePlant(id) { const p = state.plants.find((x) => x.id === id); if (p) p.archivedByTest = true; },
+    detailPlantId() { return state.shown || ''; },
+  };
+  g.window = g;
+  vm.createContext(g);
+  vm.runInContext(src, g, { filename: 'build63.js' });
+  return g;
+}
+
+check('an unset id list hides no Rocco and no descendant', () => {
+  const named = { id: 'r1', name: 'Rocco', sample: true, provenance: 'sample', status: 'Active' };
+  const child = { id: 'low', name: 'Lower cross', b49Father: 'mf:r1', status: 'active' };
+  const g = boot({ motherFatherPlants: [named], plants: [child], breedingProjects: [], _kids: {} });
+  if (g.B63.explicitId(named) || g.B63.projectVisible([named, child]).length !== 2) throw new Error('default hid a record');
+  if (g.B63.pendingMetadata().join(' ').indexOf('hideIds is empty') < 0) throw new Error('pending metadata');
+  const before = JSON.stringify(g.state.motherFatherPlants);
+  g.B41.mfpOpen();
+  if (JSON.stringify(g.state.motherFatherPlants) !== before) throw new Error('state changed');
+});
+check('only the configured id is hidden and its child stays', () => {
+  const named = { id: 'r1', name: 'Rocco', status: 'Active' };
+  const child = { id: 'low', name: 'Lower cross', b49Father: 'mf:r1', status: 'active' };
+  const g = boot({
+    motherFatherPlants: [named],
+    plants: [child],
+    breedingProjects: [],
+    _kids: { 'pr:me': ['pr:me', 'mf:r1', 'pl:low'] },
+  });
+  g.B63.configure({ hideIds: ['r1'] });
+  if (!g.B63.explicitId(named) || g.B63.explicitId(child)) throw new Error('id scope');
+  const kids = g.B49.children('pr:me');
+  if (kids.includes('pr:me') || kids.includes('mf:r1')) throw new Error(kids.join(','));
+  if (!kids.includes('pl:low')) throw new Error('descendant hidden');
+  if (JSON.stringify(g.state.motherFatherPlants) !== JSON.stringify([named])) throw new Error('state written');
+});
+check('a retired mother leaves the active projection and stays in the record array', () => {
+  const retired = { id: 'nl', name: 'Northern lights #5', status: 'Retired' };
+  const live = { id: 'c', name: 'Cannalien', status: 'Active' };
+  const rows = [retired, live];
+  const g = boot({ motherFatherPlants: rows, plants: [], breedingProjects: [], _kids: {} });
+  const active = g.B63.projectActiveMothers(rows);
+  if (active.some((m) => m.id === 'nl') || !active.some((m) => m.id === 'c')) throw new Error('active projection');
+  if (g.B63.projectVisible(rows).length !== 2) throw new Error('retired removed from history projection');
+  g.B41.mfpOpen();
+  if (g.state.motherFatherPlants !== rows) throw new Error('array replaced');
+});
+check('archive refuses a stale shown id and keeps the plant', () => {
+  const plant = { id: 'p2', name: 'Other', status: 'active' };
+  const g = boot({ motherFatherPlants: [], plants: [plant], breedingProjects: [], _kids: {}, shown: 'p1' });
+  g.archivePlant('p2');
+  if (plant.archivedByTest) throw new Error('stale id archived');
+  g.state.shown = 'p2';
+  g.archivePlant('p2');
+  if (!plant.archivedByTest) throw new Error('explicit id blocked');
+});
+check('build 62 flower guard and tag wrap and sheet lock are still present', () => {
+  if (!app.includes("const APP_BUILD = '63';")) throw new Error('build');
+  if (!app.includes('if (legacyFlip <= todayKey) p.flowerStartDate = legacyFlip;')) throw new Error('future flip guard missing');
+  if (!app.includes('else p.plannedFlipDate = legacyFlip;')) throw new Error('planned flip missing');
+  if (!tags.includes('.tag-top .m-t') || !tags.includes('word-break: normal')) throw new Error('tag wrap');
+  if (!b59.includes('dialog.modal[open]')) throw new Error('sheet lock selector');
+});
+check('inspection and tree reflow without a horizontal scroll port', () => {
+  if (!css.includes('#compliance-panel-inspection .compliance-table th')) throw new Error('table');
+  if (!css.includes('word-break: normal') || !css.includes('overflow: visible')) throw new Error('clip');
+  if (!css.includes('grid-template-columns')) throw new Error('reflow');
+  if (/overflow-x:\s*auto/.test(css) || /overflow-x:\s*hidden/.test(css)) throw new Error('horizontal scroll');
+  if (!css.includes('overflow-x: clip')) throw new Error('tree clip');
+});
+check('no production id is hardcoded', () => {
+  const bad = ['Rocco', 'Arghandab', 'Romscotti', 'Northern lights'];
+  bad.forEach((s) => { if (src.includes(s) || css.includes(s)) throw new Error('name ' + s); });
+});
+
+console.log('b63 remaining: all checks passed');
